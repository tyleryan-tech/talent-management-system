# 服务监听端口
PORT=3000

# JWT 密钥（生产环境务必改为长随机串）
JWT_SECRET=change-me-to-a-long-random-string

# SQLite 数据库文件路径（目录需可写）
DB_PATH=./data/talent-hub.db

# 允许的浏览器来源（逗号分隔；* 表示任意，仅建议开发环境）
# 前端在 Vercel、API 在别处时，填你的 Vercel 站点，例如：https://your-app.vercel.app
# 若前端通过 Vercel /api 反代访问 API（浏览器只见同源），可继续用 * 或仍填 Vercel 域名
# 注意：留空时将仅允许同源请求（最安全）
CORS_ORIGINS=https://your-app.vercel.app
