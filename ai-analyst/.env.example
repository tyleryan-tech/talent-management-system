# =====================================================
# AI 数据分析中间件 — 环境变量模板
# 复制本文件为 .env 并填入实际值
# =====================================================

# ---------- DeepSeek LLM ----------
# DeepSeek API 密钥（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型名称（默认 deepseek-chat，可选 deepseek-reasoner 等）
DEEPSEEK_MODEL=deepseek-chat
# API 基础地址（兼容 OpenAI 格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 数据库 ----------
# ⚠️ 安全要求：必须使用【只读账号】连接，禁止使用 root / admin 等高权限账号
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
# 示例：mysql+pymysql://readonly_user:P@ssw0rd@127.0.0.1:3306/talent_hub
DATABASE_URL=mysql+pymysql://readonly_user:password@127.0.0.1:3306/talent_hub

# ---------- 应用 ----------
# Streamlit 服务端口
APP_PORT=8501
# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ---------- 主系统登录态 ----------
# 生产默认要求从主系统进入，并校验 /api/ai-analyst/session 签发的会话。
# 本地单独调试 Streamlit 时可临时设为 false。
AI_ANALYST_AUTH_REQUIRED=true
# 与主系统后端 AI_ANALYST_SESSION_SECRET 保持一致；未单独配置时可与 JWT_SECRET 一致。
AI_ANALYST_SESSION_SECRET=replace-with-shared-secret
