# 复制到 Vercel：Project → Settings → Environment Variables
# 值为 Node API 根地址，无尾斜杠（与浏览器里能打开的 REST 根一致）

TM_API_ORIGIN=https://your-node-api.example.com

# AI 分析模型配置（OpenAI-compatible；未配置时返回系统内置分析摘要）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 旧版 Streamlit 备用入口；主路径已合入同源 /api/ai-analyst/*。
TM_AI_ANALYST_URL=https://your-ai-analyst.streamlit.app
AI_ANALYST_SESSION_SECRET=change-me-to-the-same-ai-session-secret
