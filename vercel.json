{
  "version": 2,
  "functions": {
    "api/[...slug].js": {
      "maxDuration": 10,
      "includeFiles": "server/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).+)",
      "destination": "/index.html"
    }
  ]
}
