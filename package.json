{
  "name": "talent-management-system",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:vite": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-dev-checks.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:headed": "node scripts/run-browser-tests.mjs --headed",
    "test:server": "node --test tests/node-api.test.mjs",
    "verify:dev": "node scripts/run-dev-checks.mjs",
    "verify:dev:self-heal": "node scripts/run-dev-checks.mjs --self-heal --max-rounds=3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "vue": "^3.4.27",
    "vue-router": "^4.4.0",
    "pinia": "^2.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "playwright": "^1.59.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0"
  }
}
